# Cloudflare Tunnel token (from Cloudflare Zero Trust dashboard)
# Networks > Cloudflare Tunnels > [your tunnel] > Configure > Token
TUNNEL_TOKEN=

# Your root domain (e.g. example.com -- NOT mcp.example.com)
# Used in Caddyfile as {$DOMAIN} for subdomain routing
DOMAIN=

# Weaviate connection (used by mcp-server; weaviate runs as a co-located Docker service)
# WEAVIATE_HOST is the Docker service name -- resolves via Docker DNS inside the stack.
# For local development outside Docker, set WEAVIATE_HOST=localhost
WEAVIATE_HOST=weaviate
WEAVIATE_PORT=8080
WEAVIATE_GRPC_PORT=50051
