marker=\"20b\">\n<p data-aid=\"128419178\" id=\"note20_b_p1\"><span data-note-category=\"cross-ref\"><a class=\"scripture-ref\" href=\"/study/scriptures/ot/ps/105?lang=eng&amp;id=p29#p29\">Ps. 105:29</a>.</span></p>\n</li>\n</ul>\n</li>\n<li data-marker=\"23\">\n<ul class=\"marker\" data-type=\"marker\">\n<li data-marker=\"a\" id=\"note23_a\" data-full-marker=\"23a\">\n<p data-aid=\"128419179\" id=\"note23_a_p1\"><span data-note-category=\"trn\">Hebrew idiom meaning “paying no regard even to this.”</span></p>\n</li>\n</ul>\n</li>\n</ul>\n</li>\n</ul>\n</footer>", "footnotes": {"note11_a": {"context": "sorcerers", "id": "note11_a", "marker": "11a", "pid": "128419107", "referenceUris": [{"href": "/study/scriptures/tg/false-prophets?lang=eng", "text": "TG False Prophets", "type": "scripture-ref"}, {"href": "/study/scriptures/tg/sorcery?lang=eng", "text": "Sorcery", "type": "scripture-ref"}], "text": "<p data-aid=\"128419166\" id=\"note11_a_p1\"><span data-note-category=\"tg\"><a class=\"scripture-ref\" href=\"/study/scriptures/tg/false-prophets?lang=eng\"><small>TG</small> False Prophets</a>; <a class=\"scripture-ref\" href=\"/study/scriptures/tg/sorcery?lang=eng\">Sorcery</a>.</span></p>"}, "note11_b": {"context": "magicians", "id": "note11_b", "marker": "11b", "pid": "128419107", "referenceUris": [{"href": "/study/scriptures/tg/false-priesthoods?lang=eng", "text": "TG False Priesthoods", "type": "scripture-ref"}], "text": "<p data-aid=\"128419167\" id=\"note11_b_p1\"><span data-note-category=\"tg\"><a class=\"scripture-ref\" href=\"/study/scriptures/tg/false-priesthoods?lang=eng\"><small>TG</small> False Priesthoods</a>.</span></p>"}, "note13_a": {"context": "And", "id": "note13_a", "marker": "13a", "pid": "128419112", "text": "<p data-aid=\"128419168\" id=\"note13_a_p1\"><span data-note-category=\"jst\"><small>JST</small> Ex. 7:13 And <em>Pharaoh</em> hardened <em>his</em> heart …</span></p>"}, "note15_a": {"context": "against he come", "id": "note15_a", "marker": "