.git
.gitignore
.claude/
.planning/
.goal/
.vscode/
__pycache__/
**/__pycache__/
**/*.pyc
.pytest_cache/
**/*.db
**/*.db-shm
**/*.db-wal
**/*.sqlite
**/*.bin
**/*.json
**/*.txt
!requirements.txt
# The Church data files build.py and fetch.py read are versioned in git and baked into the tools image
!topics.json
!db/one-off-migration/talk_metadata.json
!db/one-off-migration/talk_previews.json
!db/one-off-migration/conference_topics.json
!db/one-off-migration/talk_corrections.json
# The skills the server serves ship whole, including any .txt or .json reference files
!skills/**/*.json
!skills/**/*.txt
db/sci/
data/
output/
tasks/
docs/
tests/
benchmark/
# chromadb is a dev package, not in the image, so its script would not start there
scripts/verify_chromadb_pipeline.py
**/.env
**/.env.*
