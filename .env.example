# .env.example
# Copy this file to .env and fill in your values.
# DO NOT commit .env to git.

# Embedding server (llama-server serving nomic-embed-text) — must be reachable from inside the containers.
# Use whatever host and port it actually runs on.
EMBEDDING_URL=http://<embedder-host>:<port>

# FastMCP server network configuration
# These override FastMCP defaults (127.0.0.1:8000) for Docker deployment
FASTMCP_HOST=0.0.0.0
FASTMCP_PORT=7363

# For scripts run on the host (not in Docker): where Weaviate is reachable from the host.
# docker-compose.yml sets WEAVIATE_HOST, WEAVIATE_PORT and WEAVIATE_GRPC_PORT for the containers under environment:,
# so these values never reach them. To reach the compose Weaviate from the host, add
# docker-compose.weaviate-ports.yml (127.0.0.1:8080 and 127.0.0.1:50051).
WEAVIATE_HOST=<weaviate-host>
WEAVIATE_PORT=<weaviate-http-port>
WEAVIATE_GRPC_PORT=<weaviate-grpc-port>

# Compose files to use. Hosted deploy behind a reverse proxy on the external `proxy` network:
# COMPOSE_FILE=docker-compose.yml:docker-compose.proxy.yml
# Leave unset to run on the base file alone (server on 127.0.0.1:7363).

# Owner of the files the tools service writes into ./db (defaults 1000:1000); set to `id -u` / `id -g`.
# HOST_UID=1000
# HOST_GID=1000

# ScaleKit OAuth 2.1 (optional — enables OAuth flow for MCP clients)
# Leave ALL THREE blank/unset to run in local mode (no auth).
# Set ALL THREE for remote/hosted mode with ScaleKit JWT validation.
#
# Setup: https://docs.scalekit.com/mcp/overview/
#   1. Create an "MCP Server" resource in ScaleKit Dashboard
#   2. Note the Resource ID -> SCALEKIT_RESOURCE_ID
#   3. Set SCALEKIT_ENVIRONMENT_URL to your ScaleKit environment URL
#   4. Set MCP_BASE_URL to your server's public URL (e.g., Cloudflare tunnel)
SCALEKIT_ENVIRONMENT_URL=
SCALEKIT_RESOURCE_ID=
MCP_BASE_URL=

# SCI release number: db/core.<N>.db and db/content.<N>.db (compose reads them from the mounted data directory)
SCI_DB_VERSION=55
