sh)","distributionUrl":"https://www.churchofjesuschrist.org/imgs/cc3cac93335bce8fbaf48e4a9b6b6d020903d6cf/full/320,/0/default","seoDescription":"Song from Hymns (English)","seoTitle":"No Title","shareableTitle":"No Title","title":"No Title","renditions":[{"distributionUrl":"https://www.churchofjesuschrist.org/imgs/cc3cac93335bce8fbaf48e4a9b6b6d020903d6cf/full/!320%2C480/0/default","width":320,"height":480},{"distributionUrl":"https://www.churchofjesuschrist.org/imgs/cc3cac93335bce8fbaf48e4a9b6b6d020903d6cf/full/!60%2C90/0/default","width":60,"height":90},{"distributionUrl":"https://www.churchofjesuschrist.org/imgs/cc3cac93335bce8fbaf48e4a9b6b6d020903d6cf/full/!250%2C375/0/default","width":250,"height":375},{"distributionUrl":"https://www.churchofjesuschrist.org/imgs/cc3cac93335bce8fbaf48e4a9b6b6d020903d6cf/full/!200%2C300/0/default","width":200,"height":300},{"distributionUrl":"https://www.churchofjesuschrist.org/imgs/cc3cac93335bce8fbaf48e4a9b6b6d020903d6cf/full/!100%2C150/0/default","width":100,"height":150}]}},{"assetType":"MOBILE_PDF","distributionUrl":"https://assets.churchofjesuschrist.org/07/f9/07f9e95243f111ecbb10eeeeac1e44559d55e64b/the_morning_breaks_eng.pdf","title":"The Morning Breaks","description":"Sheet music for the hymn “The Morning Breaks” (English).","mimeType":"application/pdf","duration":0,"publicAltText":"","performer":[],"fileName":"","pianoMarvelUrl":"","thumbnail":{"description":"","distributionUrl":"","seoDescription":"","seoTitle":"","shareableTitle":"","title":"","renditions":[]}}],"verses":[{"verseBody":"<p data-aid=\"00000196-c5b6-d977-abf6-f7b74b240000\" data-pid=\"1\">The morning breaks, the shadows flee;</p><br><br><p data-aid=\"00000196-c5b6-d977-abf6-f7b74b240001\" data-pid=\"2\">Lo, Zion’s standard is unfurled!</p><br><br><p data-aid=\"00000196-c5b6-d977-abf6-f7b74b240002\" data-pid=\"3\">The dawning of a brighter day,</p><br><br><p data-aid=\"00000196-c5b6-d977-abf6-f7b74b240003\" data-pid=\"4\">The dawning of a brighter day</p><br><br><p data-aid=\"00000196-c5b6-d977-abf6-f7b74b240004\" data-pid=\"5\">Majestic rises on the world.</p>","verseNumber":1,"verseType":"Verse"},{"verseBody":"<p data-aid=\"00000196-c5b6-d977-abf6-f7b74b2c0000\" data-pid=\"1\">The clouds of error disappear</p><br><br><p data-aid=\"00000196-c5b6-d977-abf6-f7b74b2c0001\" data-pid=\"2\">Before the rays of truth divine;</p><br><br><p data-aid=\"00000196-c5b6-d977-abf6-f7b74b2c0002\" data-pid=\"3\">The glory bursting from afar,</p><br><br><p data-aid=\"00000196-c5b6-d977-abf6-f7b74b2c0003\" data-pid=\"4\">The glory bursting from afar</p><br><br><p data-aid=\"00000196-c5b6-d977-abf6-f7b74b2c0004\" data-pid=\"5\">Wide o’er the nations soon will shine.</p>","verseNumber":2,"verseType":"Verse"},{"verseBody":"<p data-aid=\"00000196-c5b6-d977-abf6-f7b74b350000\" data-pid=\"1\">The Gentile fulness now comes in,</p><br><br><p data-aid=\"00000196-c5b6-d977-abf6-f7b74b350001\" data-pid=\"2\">And Israel’s blessings are at hand.</p><br><br><p data-aid=\"00000196-c5b6-d977-abf6-f7b74b350002\" data-pid=\"3\">Lo, Judah’s remnant, cleansed from sin,</p><br><br><p data-aid=\"00000196-c5b6-d977-abf6-f7b74b350003\" data-pid=\"4\">Lo, Judah’s remnant, cleansed from sin,</p><br><br><p data-aid=\"00000196-c5b6-d977-abf6-f7b74b350004\" data-pid=\"5\">Shall in their promised Canaan stand.</p>","verseNumber":3,"verseType":"Verse"},{"verseBody":"<p data-aid=\"00000196-c5b6-d977-abf6-f7b74b3d0000\" data-pid=\"1\">Jehovah speaks! Let earth give ear,</p><br><br><p data-aid=\"00000196-c5b6-d977-abf6-f7b74b3d0001\" data-pid=\"2\">And Gentile nations turn and live.</p><br><br><p data-aid=\"00000196-c5b6-d977-abf6-f7b74b3d0002\" data-pid=\"3\">His mighty arm is making bare,</p><br><br><p data-aid=\"00000196-c5b6-d977-abf6-f7b74b3d0003\" data-pid=\"4\">His mighty arm is making bare</p><br><br><p data-aid=\"00000196-c5b6-d977-abf6-f7b74b3d0004\" data-pid=\"5\">His cov’nant people to receive.</p>","verseNumber":4,"verseType":"Verse"},{"verseBody":"<p data-aid=\"00000196-c5b6-d977-abf6-f7b74b450000\" data-pid=\"1\">—Angels from heav’n and truth from earth</p><br><br><p data-aid=\"00000196-c5b6-d977-abf6-f7b74b450001\" data-pid=\"2\">Have met, and both have record borne;</p><br><br><p data-aid=\"00000196-c5b6-d977-abf6-f7b74b450002\" data-pid=\"3\">Thus Zion’s light is bursting forth,</p><br><br><p data-aid=\"00000196-c5b6-d977-abf6-f7b74b450003\" data-pid=\"4\">Thus Zion’s light is bursting forth</p><br><br><p data-aid=\"00000196-c5b6-d977-abf6-f7b74b450004\" data-pid=\"5\">To bring her ransomed children home.</p>","verseNumber":5,"verseType":"Verse"}],"scriptures":[{"linkText":"Isaiah 60:1–3","linkUrl":"/scriptures/ot/isa/60?id=p1-p3#p1","$id":"000001a0-8c69-d8d2-adb8-ed7bc8d50000"},{"linkText":"3 Nephi 16:7–20","linkUrl":"/scriptures/bofm/3-ne/16?id=p7-p20#p7","$id":"000001a0-8c69-d8d2-adb8-ed7bc8d50001"}],"title":"The Morning Breaks","description":"“The Morning Breaks” from Hymns (English).","url":"https://www.churchofjesuschrist.org/media/music/songs/the-morning-breaks?lang=eng","tunes":[{"$id":"00000184-0c30-d3a5-ab95-1dfa2c670000","name":"Hudson","alternateTitles":[]}],"fullCreditsText":"<p data-aid=\"000001a0-8c11-d8d2-adb8-ed13bdcb0000\" data-pid=\"p_hS6sX\"><i>Text:</i> Parley P. Pratt, 1807–1857</p><br><br> <p data-aid=\"000001a0-8c11-d8d2-adb8-ed13bdcb0001\" data-pid=\"p_ty08c\"><i>Music:</i> George Careless, 1839–1932</p>","slug":"the-morning-breaks"},"limit":1,"offset":0,"total":1,"correlationToken":"f0ca1ec1-3a14-49fd-bc50-660d211eef4e"}